{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerminalDeck",
  "version": "0.1.0",
  "identifier": "com.terminaldeck.app",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerminalDeck",
        "width": 780,
        "height": 560,
        "minWidth": 780,
        "minHeight": 560,
        "maxWidth": 900,
        "maxHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": false,
        "hiddenTitle": true,
        "titleBarStyle": "overlay",
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sid Mohan",
    "category": "DeveloperTool",
    "shortDescription": "Control Claude Code with Stream Deck + voice",
    "longDescription": "TerminalDeck lets you control Claude Code entirely through a Stream Deck and voice dictation. Designed for accessibility and hands-free coding.",
    "copyright": "Copyright © 2025 Sid Mohan. All rights reserved.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/sidmohan0/terminaldeck/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QUIyQzQ0NTI5MDYxNzcKUldSM1laQlNSQ3lyMTh3ZWFjd05oOU5xRUVSZXdRT2swdEh1WE5NUGVsZHVCKzZDSUdUWXhHRUcK"
    }
  }
}
